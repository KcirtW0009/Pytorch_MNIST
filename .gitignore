.directory
.Trash-*
.nfs*

# ============================================
# 4. 数据集文件 / Dataset files (Large files)
# ============================================
# MNIST 原始数据 (约11MB) - 通常通过代码自动下载
data/MNIST/raw/*.gz
data/MNIST/processed/*.pt
data/MNIST/processed/*.pth

# 其他数据集格式
*.csv
*.xlsx
*.xls
*.jsonl
*.parquet
*.h5
*.hdf5
*.npz
*.npy
*.tar.gz (如果包含数据)
*.zip (如果包含数据)

# 大型数据目录
datasets/
data/raw/
data/external/

# ============================================
# 5. 模型和权重文件 / Model and weight files (Large)
# ============================================
# 训练好的模型 (通常几十MB到几GB)
models/*.pkl
models/*.pth
models/*.pt
models/*.h5
models/*.pb
models/*.onnx
models/*.tflite

# 检查点文件
checkpoints/
*.ckpt
checkpoint

# TensorBoard 日志 (可能很大)
runs/
logs/tensorboard/
events.out.tfevents.*

